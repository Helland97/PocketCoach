# ============================================================
# Python .dockerignore for the python-backend build context (./AI)
# ============================================================

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual / conda environments (very large — never bake into image)
.conda/
venv/
env/
ENV/
.venv/

# Volume-mounted directories (populated at runtime)
Videos/
ProcessedVideos/
MediaPipe_landmarks/
videos/

# Research / development artifacts not needed at runtime
Model_research_notebooks/
training_data/
embedding/
mlp/models/
test.py
test_embeddings.py

# OS / IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in runtime image)
*.md
README*

# Solution files
*.sln
