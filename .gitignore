# ========================================
# Generated / volume-mounted directories
# (Folders themselves are tracked via a .gitignore inside each;
#  all content within them is ignored. See:
#    AI/MediaPipe_landmarks/.gitignore
#    AI/ProcessedVideos/.gitignore
#    AI/embedding/.gitignore
#    AI/videos/.gitignore
#    Backend/Videos/.gitignore
# )
# ========================================
AI/.conda/

# ========================================
# Trained model weights & training data
# (User-trained artifacts — stay local)
# ========================================
AI/mlp/models/*.pt
AI/mlp/models/*.npz
AI/mlp/models/*.json
AI/training_data/**/*.npy

# Pro reference templates — kept local, not committed
AI/templates/

# Model research notebooks — scratch work, stay local
AI/Model_research_notebooks/
